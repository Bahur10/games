# ─── Supabase ────────────────────────────────────────────────────────────────
# Copy this file to ".env.local" and fill in your project values:
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ─── Demo mode (only used when the Supabase variables above are missing) ────
# In demo mode all data is stored in the browser (localStorage) and the
# professor logs in with these credentials. Defaults if unset:
#   email:    professor@example.com
#   password: admin123
# NEXT_PUBLIC_DEMO_ADMIN_EMAIL=professor@example.com
# NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=admin123
