# ─── Supabase ────────────────────────────────────────────────────────────────
# Copy this file to ".env.local" and fill in your project values:
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ─── Demo mode (only used when the Supabase variables above are missing) ────
# In demo mode all data is stored in the browser (localStorage) and the
# professor logs in with a UserName + PassCode. Defaults if unset:
#   UserName: professor
#   PassCode: admin123
# NEXT_PUBLIC_DEMO_ADMIN_USERNAME=professor
# NEXT_PUBLIC_DEMO_ADMIN_PASSCODE=admin123
